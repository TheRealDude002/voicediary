{
  "expo": {
    "name": "VoiceDiary",
    "slug": "voicediary-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf6ee"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voicediary.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VoiceDiary needs microphone access to record your voice entries.",
        "NSDocumentsFolderUsageDescription": "VoiceDiary saves exported entries to your Documents folder.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf6ee"
      },
      "permissions": [
        "RECORD_AUDIO",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.voicediary.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "experiments": {
      "tsconfigPaths": false
    },
    "extra": {
      "apiUrl": "http://localhost:4000/api"
    },
    "env": {
      "EXPO_PUBLIC_API_URL": "http://localhost:4000/api"
    }
  }
}

# ────────────────────────────────────────────────────────────────────
# VoiceDiary backend environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ────────────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (your Expo web dev server,
# the Expo Go app, your production frontend, etc.)
# Example: http://localhost:8081,http://localhost:19006,https://voicediary.example.com
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/voicediary

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (audio file storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Folder prefix inside your Cloudinary account
CLOUDINARY_AUDIO_FOLDER=voicediary/audio

# Primary transcriber — ANY OpenAI-compatible audio transcription API.
# Defaults to OpenAI itself; repoint to Groq / Together / DeepInfra / etc.
# by changing OPENAI_BASE_URL + OPENAI_WHISPER_MODEL (and the key, of course).
#
# ── OpenAI (default) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
#
# ── Groq swap (just uncomment these three lines, comment out the OpenAI block above) ──
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_WHISPER_MODEL=whisper-large-v3
#   (alternatives: whisper-large-v3-turbo, distil-whisper-large-v3-en)
#
# Whisper response_format. One of: json, text, srt, verbose_json, vtt
# verbose_json is the only format that returns word-level timestamps.
# Groq supports the same formats.
OPENAI_WHISPER_RESPONSE_FORMAT=verbose_json

# Google Gemini (fallback transcriber — fires on ANY Whisper error)
# Free-tier model: gemini-2.0-flash (rate-limited but free)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# Upload limits
# 25MB hard cap — both Whisper and Gemini reject audio larger than this,
# so accepting anything bigger would just guarantee a `failed` entry.
MAX_AUDIO_BYTES=26214400
